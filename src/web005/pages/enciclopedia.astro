---
import Layout from '../components/Layout.astro';
import Card from '../components/Card.astro';
import {entries,families,states} from '../catalog';
---
<Layout title="Enciclopedia"><h1>Enciclopedia</h1><p class="lead">308 artículos completos. Busca en todo el texto y combina filtros.</p><form id="catalog-search" role="search"><label for="query">Buscar por texto o identificador</label><input id="query" name="q" type="search" maxlength="200"/><div class="filters"><label>Familia<select name="family"><option value="">Todas las familias</option>{Object.entries(families).map(([id,label])=><option value={id}>{label}</option>)}</select></label><label>Mapa<select name="map"><option value="">Todos los mapas</option>{['Común','Chernarus','Livonia'].map(m=><option>{m}</option>)}</select></label><label>Estado editorial de origen<select name="state"><option value="">Todos los estados</option>{Object.entries(states).map(([id,label])=><option value={id}>{label}</option>)}</select></label><label>Técnica<select name="technical"><option value="">Todas las entradas</option><option value="pending">Revisión atómica pendiente</option><option value="verified">Verificado en cliente</option></select></label></div><button type="reset">Limpiar búsqueda y filtros</button></form><p id="search-status" role="status" aria-live="polite" aria-atomic="true">308 artículos. Mostrando los primeros 12.</p><p id="load-error" hidden>La búsqueda no está disponible. Utiliza los índices completos por familia.</p><h2 id="results-heading" tabindex="-1">Resultados</h2><ul id="results" class="cards">{entries.slice(0,12).map(e=><Card entry={e}/>)}</ul><p id="empty" hidden>No hay resultados. Prueba otra consulta o limpia los filtros.</p><nav class="pagination" aria-label="Páginas de resultados"><button id="previous" aria-disabled="true">Anterior</button><span id="page-number">Página 1</span><button id="next" aria-disabled="false">Siguiente</button></nav><noscript><p>La búsqueda requiere JavaScript. Los ocho índices de familia y todos los artículos funcionan sin él.</p></noscript><nav aria-label="Índices completos por familia" class="actions">{Object.entries(families).map(([id,label])=><a href={`/familias/${id}/`}>{label}</a>)}</nav><script src="../search.ts"/></Layout>
