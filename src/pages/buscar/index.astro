---
import Layout from '../../layouts/Layout.astro';
import DemoNotice from '../../components/DemoNotice.astro';
import Icon from '../../components/Icon.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { demoArticle } from '../../data/demo';
---
<Layout title="Buscar en el manual"><div class="container"><header class="page-intro"><nav class="breadcrumb" aria-label="Ruta de navegación"><a href="/">Inicio</a><span>/</span><span>Buscar</span></nav><span class="eyebrow">ÍNDICE LOCAL / TEXTO COMPLETO</span><h1>Encuentra tu lectura.</h1><p>Busca en títulos, etiquetas y texto. El índice de esta edición contiene únicamente el artículo de demostración.</p><DemoNotice compact/></header><section class="page-content" aria-label="Buscador del manual"><form class="search-box" action="/buscar/" method="get" role="search"><Icon name="search" size={22}/><label for="search-input" class="sr-only">Buscar en el manual</label><input id="search-input" name="q" type="search" placeholder="Buscar en el manual" autocomplete="off" maxlength="200"/><button class="button" type="submit">Buscar <Icon size={16}/></button></form><div class="filter-row" aria-label="Filtrar por etiqueta"><span>ETIQUETAS</span><button type="button" class="filter" data-tag="" aria-pressed="true">Todas</button>{demoArticle.tags.map(tag=><button type="button" class="filter" data-tag={tag} aria-pressed="false">{tag}</button>)}</div><p id="search-status" class="search-status" role="status" aria-live="polite">1 resultado de demostración</p><div id="search-results"><ArticleCard/></div><div id="no-results" class="no-results" hidden><h2>No se encontraron resultados</h2><p>Prueba con «lectura», «ficha» o elimina el filtro. Esta edición solo incluye un ejemplo.</p></div><p class="search-help">La búsqueda se ejecuta en tu navegador. No envía consultas a servicios externos.</p><noscript><p>La búsqueda y los filtros necesitan JavaScript. Puedes abrir el ejemplo mostrado o recorrer <a class="body-link" href="/manual/">el manual</a>.</p></noscript></section></div><script>import { demoArticles } from '../../data/demo';import { searchArticles } from '../../lib/search';const input=document.querySelector<HTMLInputElement>('#search-input');const form=document.querySelector<HTMLFormElement>('.search-box');const results=document.querySelector<HTMLElement>('#search-results');const empty=document.querySelector<HTMLElement>('#no-results');const status=document.querySelector<HTMLElement>('#search-status');const filters=[...document.querySelectorAll<HTMLButtonElement>('[data-tag]')];const params=new URLSearchParams(location.search);let selected=filters.some(b=>b.dataset.tag===params.get('tag'))?(params.get('tag')??''):'';if(input)input.value=(params.get('q')??'').slice(0,200);function update(){if(!input||!results||!empty||!status)return;const found=searchArticles(demoArticles,input.value,selected);results.hidden=found.length===0;empty.hidden=found.length>0;status.textContent=found.length===1?'1 resultado de demostración':'0 resultados de demostración';filters.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.tag===selected)));const query=new URLSearchParams();if(input.value)query.set('q',input.value);if(selected)query.set('tag',selected);history.replaceState(null,'',`${location.pathname}${query.size?'?'+query.toString():''}`);}form?.addEventListener('submit',event=>{event.preventDefault();update();});input?.addEventListener('input',update);filters.forEach(b=>b.addEventListener('click',()=>{selected=b.dataset.tag??'';update();}));update();</script></Layout>
