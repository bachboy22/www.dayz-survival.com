---
import Layout from '../../layouts/Layout.astro';
import DemoNotice from '../../components/DemoNotice.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import TopicIndex from '../../components/content/TopicIndex.astro';
import { catalog } from '../../data/catalog';
---
<Layout title="Manual"><div class="container"><header class="page-intro"><nav class="breadcrumb" aria-label="Ruta de navegación"><a href="/">Inicio</a><span>/</span><span>Manual</span></nav><span class="eyebrow">FIELD MANUAL / DEMO</span><h1>El manual.</h1><p>Lectura extensa, referencias y consulta breve. Tres textos sintéticos para probar el recorrido; ningún manuscrito publicado.</p><DemoNotice/></header><div class="page-content manual-layout"><aside class="side-panel"><TopicIndex/><p class="back-link"><a class="text-link" href="/fichas/">Todas las fichas rápidas →</a></p><p class="back-link"><a class="text-link" href="/buscar/">Buscar y filtrar →</a></p></aside><section aria-labelledby="entries-title"><div class="list-heading"><h2 id="entries-title">Lecturas de demostración</h2><span>{catalog.length} ENTRADAS DEMO</span></div><div class="catalog-grid single">{catalog.map(article => <ArticleCard article={article}/>)}</div></section></div></div></Layout>
