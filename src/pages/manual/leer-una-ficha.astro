---
import Layout from '../../layouts/Layout.astro';
import DemoNotice from '../../components/DemoNotice.astro';
import Icon from '../../components/Icon.astro';
import { demoArticle } from '../../data/demo';
---
<Layout title={demoArticle.title}><div class="container"><header class="page-intro"><nav class="breadcrumb" aria-label="Ruta de navegación"><a href="/">Inicio</a><span>/</span><a href="/manual/">Manual</a><span>/</span><span>Ejemplo de lectura</span></nav><span class="eyebrow">LECTURA DE CAMPO / {demoArticle.id}</span><h1>{demoArticle.title}</h1><p>{demoArticle.summary}</p><div class="article-meta"><span><Icon name="clock" size={16}/>{demoArticle.readingMinutes} min de lectura</span><span>Editorial: demostración</span><span>Técnico: sin verificar</span></div><DemoNotice/></header><div class="page-content"><div class="article-layout"><aside class="article-nav" aria-label="En este artículo"><span class="eyebrow">EN ESTA LECTURA</span><ol>{demoArticle.sections.map((section) => <li><a href={`#${section.id}`}>{section.title}</a></li>)}<li><a href="#ficha-rapida">Ficha rápida</a></li><li><a href="#referencias">Referencias cruzadas</a></li></ol><a class="text-link" href="/fichas/">Abrir la ficha <Icon size={14}/></a></aside><article class="reader"><div class="reader-tools"><span class="reader-label">CUADERNO DE DEMOSTRACIÓN</span><div class="size-controls"><span class="tool-label">TEXTO</span><button type="button" id="text-smaller" aria-label="Reducir tamaño del texto">A−</button><button type="button" id="text-larger" aria-label="Aumentar tamaño del texto">A+</button></div></div><span class="reader-label">EJEMPLO SINTÉTICO / SIN INSTRUCCIONES DE JUEGO</span>{demoArticle.sections.map(section=><section aria-labelledby={section.id}><h2 id={section.id}>{section.title}</h2>{section.paragraphs.map(paragraph=><p>{paragraph}</p>)}</section>)}<section class="quick-sheet" aria-labelledby="ficha-rapida"><span class="reader-label">FICHA RÁPIDA · DEMOSTRACIÓN</span><h2 id="ficha-rapida">{demoArticle.quickCard.title}</h2><ul>{demoArticle.quickCard.items.map(item=><li>{item}</li>)}</ul><p><a href="/fichas/">Ver esta ficha por separado →</a></p></section><section aria-labelledby="referencias"><h2 id="referencias">Referencias cruzadas</h2><p>Estos enlaces explican el proyecto y el estado de esta edición. No son evidencias sobre mecánicas de DayZ.</p><ul class="reference-list">{demoArticle.references.map(ref=><li><a href={ref.href}>{ref.label}</a></li>)}</ul></section></article></div><div class="article-bottom"><a class="text-link" href="/manual/">Volver al manual <Icon size={16}/></a><p>DEMO-001 · No forma parte de la Fuente Maestra v0.16.1</p></div></div></div><script>const reader=document.querySelector<HTMLElement>('.reader');const less=document.querySelector<HTMLButtonElement>('#text-smaller');const more=document.querySelector<HTMLButtonElement>('#text-larger');let level=0;function resize(){if(!reader||!less||!more)return;reader.style.setProperty('--reader-size',`${1.02+level*.12}rem`);less.disabled=level===0;more.disabled=level===3;}less?.addEventListener('click',()=>{level=Math.max(0,level-1);resize();});more?.addEventListener('click',()=>{level=Math.min(3,level+1);resize();});resize();</script></Layout>
