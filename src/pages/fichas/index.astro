---
import Layout from '../../layouts/Layout.astro';
import DemoNotice from '../../components/DemoNotice.astro';
import QuickFieldCard from '../../components/reader/QuickFieldCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { catalog } from '../../data/catalog';
---
<Layout title="Fichas rápidas"><div class="container"><header class="page-intro"><nav class="breadcrumb" aria-label="Ruta de navegación"><a href="/">Inicio</a><span>/</span><a href="/manual/">Manual</a><span>/</span><span>Fichas rápidas</span></nav><span class="eyebrow">FIELD CARD / DEMO</span><h1>Lo esencial, a mano.</h1><p>Consultas breves conectadas con su lectura extensa. Ejemplos de interfaz, sin consejos de juego.</p><DemoNotice/></header><div class="page-content"><article class="reader card-reader"><QuickFieldCard article={catalog[0]!} standalone/></article><section class="section-pad" aria-labelledby="more-cards"><h2 id="more-cards">Más fichas de demostración</h2><div class="catalog-grid">{catalog.slice(1).map(article => <ArticleCard article={article} view="card"/>)}</div></section></div></div></Layout>
