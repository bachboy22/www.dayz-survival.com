---
import Layout from '../../layouts/Layout.astro';
import DemoNotice from '../../components/DemoNotice.astro';
import QuickFieldCard from '../../components/reader/QuickFieldCard.astro';
import EvidenceLabel from '../../components/content/EvidenceLabel.astro';
import { catalog, type PrototypeArticle } from '../../data/catalog';
export function getStaticPaths() { return catalog.map(article => ({ params: { slug: article.slug }, props: { article } })); }
interface Props { article: PrototypeArticle }
const { article } = Astro.props;
---
<Layout title={`Ficha rápida · ${article.title}`} description={`${article.quickCard.id} · Consulta rápida DEMO de «${article.title}»: situación, decisión, error, señales y vuelta al ejemplo extenso. Sin consejos de juego.`}><div class="container"><header class="page-intro"><nav class="breadcrumb" aria-label="Ruta de navegación"><a href="/">Inicio</a><span>/</span><a href="/fichas/">Fichas rápidas</a></nav><span class="eyebrow">FIELD CARD / {article.quickCard.id}</span><h1>{article.title}</h1><p>Consulta breve del ejemplo de interfaz. Ninguna instrucción de juego.</p><DemoNotice/><EvidenceLabel/></header><div class="page-content"><article class="reader card-reader"><QuickFieldCard article={article} standalone/></article><p class="back-link"><a class="text-link" href={`/manual/${article.slug}/`}>Abrir lectura extensa: {article.title} →</a></p></div></div></Layout>
