---
import type { PrototypeArticle } from '../../data/catalog';
interface Props { article: PrototypeArticle }
const { article } = Astro.props;
---
<nav class="article-nav" aria-label="En este artículo"><h2 class="eyebrow">EN ESTA LECTURA</h2><ol>{article.sections.map(section => <li><a href={`#${section.id}`}>{section.title}</a></li>)}<li><a href="#ficha-rapida">Ficha rápida</a></li><li><a href="#version">Versión y procedencia</a></li><li><a href="#referencias">Referencias cruzadas</a></li></ol><a class="text-link" href="/fichas/">Todas las fichas →</a></nav>
