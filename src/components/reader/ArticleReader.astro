---
import Layout from '../../layouts/Layout.astro';
import DemoNotice from '../DemoNotice.astro';
import EvidenceLabel from '../content/EvidenceLabel.astro';
import GameVersionPanel from '../content/GameVersionPanel.astro';
import ArticleOutline from './ArticleOutline.astro';
import ReadingPreferences from './ReadingPreferences.astro';
import QuickFieldCard from './QuickFieldCard.astro';
import CrossReferencePanel from './CrossReferencePanel.astro';
import type { PrototypeArticle } from '../../data/catalog';
interface Props { article: PrototypeArticle }
const { article } = Astro.props;
---
<Layout title={article.title}><div class="container"><header class="page-intro"><nav class="breadcrumb" aria-label="Ruta de navegación"><a href="/">Inicio</a><span>/</span><a href="/manual/">Manual</a><span>/</span><span>Ejemplo de lectura</span></nav><span class="eyebrow">FIELD MANUAL / {article.id}</span><h1>{article.title}</h1><p>{article.summary}</p><div class="article-meta"><span>{article.readingMinutes} min de lectura</span><span>Texto sintético · sin instrucciones de juego</span></div><EvidenceLabel/><DemoNotice/><nav class="reading-modes" aria-label="Velocidad de lectura"><a class="button secondary" href="#antes-del-texto" aria-current="location">Lectura extensa</a><a class="button" href={`/fichas/${article.slug}/`}>Ficha rápida · consulta breve</a></nav></header><div class="page-content"><div class="article-layout"><ArticleOutline article={article}/><article class="reader" id="reader-content"><ReadingPreferences/><h2 class="sr-only" id="antes-del-texto" tabindex="-1">Texto extenso de demostración</h2><span class="reader-label">EJEMPLO SINTÉTICO / SIN INSTRUCCIONES DE JUEGO</span>{article.sections.map(section => <section aria-labelledby={section.id}><h2 id={section.id} tabindex="-1">{section.title}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}</section>)}<QuickFieldCard article={article}/><GameVersionPanel contentId={article.id}/><CrossReferencePanel article={article}/></article></div><div class="article-bottom"><a class="text-link" href="/manual/">Volver al manual →</a><p>{article.id} · No forma parte de la Fuente Maestra v0.16.1</p></div></div></div></Layout>
