{
  "name": "dayz-survival-field-manual",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "validate": "tsx scripts/validate-content.ts",
    "validate:import": "tsx scripts/validate-import.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "build": "npm run validate && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test": "npm run check && npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
